# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# From Resend: dashboard -> API Keys
RESEND_API_KEY=
# Optional: only works once you verify a domain in Resend. Until then, leave unset
# and reminders will send from onboarding@resend.dev (fine for personal use).
REMINDER_FROM_EMAIL=

# Any random long string — used to lock down the /api/cron/reminders endpoint
# so only Vercel's scheduler (not the public internet) can trigger it.
CRON_SECRET=
